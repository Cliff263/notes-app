# Neon Postgres — copy the pooled connection string from your Neon project dashboard
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Auth.js session secret — generate one with: npx auth secret
AUTH_SECRET="replace-me"

# Optional: Google sign-in. Leave these unset and the Google button is hidden.
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Optional: password-reset and confirmation email. Without a key the links are
# logged to the server console instead, so the flow still works locally.
RESEND_API_KEY=""
EMAIL_FROM=""

# Web Push reminders. Generate a pair with:
#   npx web-push generate-vapid-keys
# Leave these unset and reminders simply are not offered.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Shared secret the reminder cron must present. Without it the endpoint is off.
CRON_SECRET=
