# Neon Postgres — use the pooled connection string from your Neon dashboard.
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/database?sslmode=require"

# Auth.js session secret — generate one with: npx auth secret
AUTH_SECRET=""

# Optional Google sign-in.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Optional email delivery.
RESEND_API_KEY=""
EMAIL_FROM=""

# Optional Cloudflare R2 attachment storage. Create an Object Read & Write token
# scoped to one private bucket. Without all four values, files use Postgres.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""

# Optional Web Push reminders.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_SUBJECT=""

# Shared secret the reminder cron must present.
CRON_SECRET=""

# Optional comma-separated Yjs signalling servers.
NEXT_PUBLIC_YJS_SIGNALING=""
